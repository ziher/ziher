<% journal = @entry.journal %>
<% can_add = journal.is_not_blocked() && can?(:update, journal) %>

<div class="row">
  <div class="col-md-12">
    <% if can_add %>
      <%= link_to new_entry_path(:journal_id => journal.id, :is_expense => false), class: 'btn btn-sm btn-success' do %>
        <span class="glyphicon glyphicon-plus"></span>&nbsp;&nbsp;Dodaj nowy wpływ
      <% end %>
      <%= link_to new_entry_path(:journal_id => journal.id, :is_expense => true), class: 'btn btn-sm btn-success' do %>
        <span class="glyphicon glyphicon-minus"></span>&nbsp;&nbsp;Dodaj nowy wydatek
      <% end %>
    <% end %>
    <%= link_to journal_path(journal), class: 'btn btn-sm btn-primary' do %>
      <span class="glyphicon glyphicon-book"></span>&nbsp;&nbsp;Wyświetl książkę
    <% end %>
  </div>
</div>

<div class="row top-buffer-20">
  <div class="col-md-6">
    <div class="well">
      <div class="row">
        <div class="col-md-3">
            <strong>Data:</strong>
            <%= @entry.date %>
        </div>
        <div class="col-md-6 col-md-offset-3">
            <strong>Numer dokumentu:</strong>
            <%= @entry.document_number %>
        </div>
      </div>
      <div class="row top-buffer-20">
        <div class="col-md-9">
            <strong>Nazwa:</strong>
            <%= @entry.name %>
        </div>
        <% if @entry.color.present? %>
          <div class="col-md-3">
            <strong>Kolor:</strong>
            <span style="display: inline-block; width: 30px; height: 20px; background-color: <%= @entry.color %>; border: 1px solid #ccc; border-radius: 3px; vertical-align: middle;"></span>
            <%= @entry.color %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <% @categories.each do |category| %>
      <div class="row top-buffer-20">
        <div class="col-md-2">
          <label><%= category.name %></label>
          <input type="text" class="form-control" readonly value="<%= get_formatted_amount(@entry.get_amount_for_category(category), "") %>">
        </div>
        <% if @entry.is_expense %>
          <div class="col-md-2">
            <label>w tym 1,5%</label>
            <input type="text" class="form-control" readonly value="<%= get_formatted_amount(@entry.get_amount_one_percent_for_category(category), "") %>">
          </div>
          <% @grants.each do |grant| %>
            <div class="col-md-2">
              <label style="width: 100%;">w tym <%= grant.name %></label>
              <input type="text" class="form-control" readonly value="<%= get_formatted_amount(@entry.get_amount_for_category_and_grant(category, grant), "") %>">
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Szara linia oddzielająca -->
<div class="row top-buffer-20">
  <div class="col-md-<%= 2 * (1 + (@entry.is_expense ? 1 + @grants.count : 0)) %>">
    <hr class="my-3" style="border-top-width: 5px; border-color: #ccc;">
  </div>
</div>

<!-- Pole sumy -->
<div class="row top-buffer-20">
  <div class="col-md-2">
    <label for="total-sum">Suma</label>
    <input type="text" class="form-control" id="total-sum" readonly value="<%= get_formatted_amount(@entry.sum, "") %>">
  </div>
  <% if @entry.is_expense %>
    <div class="col-md-2">
      <label for="total-sum-one-percent">Suma 1,5%</label>
      <input type="text" class="form-control" id="total-sum-one-percent" readonly value="<%= get_formatted_amount(@entry.items.sum { |item| item.amount_one_percent || 0 }, "") %>">
    </div>
    <% @grants.each do |grant| %>
      <div class="col-md-2">
        <label for="total-sum-grant-<%= grant.id %>">Suma <%= grant.name %></label>
        <input type="text" class="form-control" id="total-sum-grant-<%= grant.id %>" readonly value="<%= get_formatted_amount(@entry.get_sum_for_grant(grant), "") %>">
      </div>
    <% end %>
  <% end %>
</div>

<div class="row top-buffer-20">
  <div class="col-md-12">
    <%= link_to 'Edytuj', edit_entry_path(@entry), class: "btn btn-sm btn-primary mx-2" %>
    <%= link_to 'Wstecz', journal_path(journal), class: "btn btn-sm btn-secondary mx-1" %>
  </div>
</div>