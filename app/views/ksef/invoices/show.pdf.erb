<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <title>Faktura KSeF <%= @invoice.ksef_number %></title>
  <%= render partial: "ksef/invoices/pdf_styles", formats: [:html] %>
</head>
<body>
  <% if @document %>
    <%= render partial: "ksef/invoices/fa/invoice", formats: [:html], locals: { document: @document, ksef_number: @invoice.ksef_number } %>
  <% else %>
    <p>Brak zapisanego XML-a faktury.</p>
  <% end %>
</body>
</html>
