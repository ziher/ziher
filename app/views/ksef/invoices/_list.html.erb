<table class="table">
  <thead>
    <tr>
      <th>Numer faktury</th>
      <th>Data wystawienia</th>
      <th>Sprzedawca</th>
      <th>Kwota brutto</th>
      <th>Jednostka</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% invoices.each do |invoice| %>
      <tr>
        <td>
          <%= link_to invoice.invoice_number.presence || "—", ksef_invoice_path(invoice) %>
          <div class="ksef-list__ksef-number"><%= invoice.ksef_number %></div>
        </td>
        <td><%= invoice.issue_date %></td>
        <td><%= invoice.seller_name %></td>
        <td><%= number_to_currency invoice.gross_amount, unit: invoice.currency %></td>
        <td><%= invoice.unit&.name || "—" %></td>
        <td><%= invoice.status_label %></td>
        <td>
          <% if can?(:release, invoice) || (current_user.is_superadmin && invoice.releasable?) %>
            <%= button_to "Oznacz jako nieprzypisaną", release_ksef_invoice_path(invoice), method: :patch, class: "btn btn-sm btn-default", form: { style: "display:inline" } %>
          <% end %>
          <% if can?(:assign, invoice) || (current_user.is_superadmin && invoice.assignable?) %>
            <%= link_to "Przypisz", ksef_invoice_path(invoice), class: "btn btn-sm btn-default" %>
          <% end %>
          <% if can?(:import, invoice) %>
            <%= link_to "Importuj", import_ksef_invoice_path(invoice), class: "btn btn-sm btn-primary" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
