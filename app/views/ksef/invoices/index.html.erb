<div class="ksef-index__header">
  <h1>KSeF — Faktury</h1>
  <% if current_user.is_superadmin %>
    <div class="ksef-index__toolbar">
      <%= link_to "Konfiguracja KSeF", edit_ksef_setting_path, class: "btn btn-default" %>
      <%= button_to "Sync", sync_ksef_setting_path, method: :post, class: "btn btn-default", form: { style: "display:inline" } %>
    </div>
  <% end %>
</div>

<% if @show_setup_warning %>
  <div class="alert alert-warning">
    Konfiguracja KSeF jest niekompletna.
    <% if current_user.is_superadmin %>
      <%= link_to "Uzupełnij ustawienia", edit_ksef_setting_path %>
    <% end %>
  </div>
<% end %>

<% tab_labels = {
     "pending"    => "Nowe",
     "unassigned" => "Do przejęcia",
     "assigned"   => "Przypisane",
     "imported"   => "Zaimportowane"
   } %>

<ul class="nav nav-tabs ksef-index__tabs">
  <% @status_tabs.each do |status| %>
    <% next if status == "pending" && !current_user.is_superadmin %>
    <li class="<%= 'active' if @active_status == status %>">
      <%= link_to ksef_invoices_path(status: status) do %>
        <%= tab_labels[status] %>
        <span class="badge"><%= @counts[status].to_i %></span>
      <% end %>
    </li>
  <% end %>
</ul>

<div class="ksef-index__body">
  <%= render "list", invoices: @invoices, empty_label: "Brak faktur w tej zakładce." %>

  <% if @pagy.pages > 1 %>
    <div class="ksef-index__pagination">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
